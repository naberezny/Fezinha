# Copie para deploy/.env e troque os valores. Gere segredos com: openssl rand -hex 32
# Senha do PostgreSQL (só letras e números: entra na URL de conexão).
POSTGRES_PASSWORD=troque-por-um-valor-aleatorio
# Chave do POST /loterias/:id/sincronizar (header X-Chave-Admin).
CHAVE_ADMIN=troque-por-um-valor-aleatorio
# Porta local (127.0.0.1) do app; o proxy do servidor aponta para ela.
PORTA_WEB=8095
# Interface da porta: 127.0.0.1 (só o próprio servidor, padrão) ou 0.0.0.0 (aberto pelo IP, sem HTTPS).
ENDERECO_WEB=127.0.0.1
# Proxy no Brasil para as chamadas à Caixa (o WAF dela bloqueia IPs do exterior). Vazio = conexão direta.
# Formato: http://usuario:senha@IP:8888
CAIXA_PROXY=
