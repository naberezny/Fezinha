# Copie para .env e ajuste. O .env nunca é versionado.
# PostgreSQL. O padrão é o do docker-compose.yml da raiz (docker compose up -d postgres).
DATABASE_URL=postgresql://sorteios:sorteios@localhost:5432/sorteios
# Servidor onde os testes da API criam um database temporário por suíte (padrão: o mesmo servidor de DATABASE_URL).
# DATABASE_URL_TESTES=postgresql://sorteios:sorteios@localhost:5432/postgres
# Chave exigida no header X-Chave-Admin do POST /loterias/:id/sincronizar
CHAVE_ADMIN=troque-esta-chave
# Base da API da Caixa (opcional; padrão: https://servicebus3.caixa.gov.br/portaldeloterias/api)
# CAIXA_API_URL=
PORTA=3000
