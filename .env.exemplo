# Copie para .env e ajuste. O .env nunca é versionado.
# Caminho do SQLite (relativo à raiz do workspace). Para PostgreSQL, ver seção 9 da especificação.
DATABASE_URL=file:./apps/api/dados/sorteios.db
# Chave exigida no header X-Chave-Admin do POST /loterias/:id/sincronizar
CHAVE_ADMIN=troque-esta-chave
# Base da API da Caixa (opcional; padrão: https://servicebus3.caixa.gov.br/portaldeloterias/api)
# CAIXA_API_URL=
PORTA=3000
